# Application
APP_NAME=Lenny Growth Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny

# LLM Provider
# Supported values: ollama, anthropic, openrouter
LLM_PROVIDER=ollama

# Ollama - local/free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Anthropic - optional cloud fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter - cloud/free models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Embeddings - local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Transcript ingestion
TRANSCRIPT_SOURCE_DIR=../data/lenny-transcripts-source/episodes

# Frontend CORS
CORS_ORIGINS=http://localhost:3000
